        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guhuza no kongerera ubushobozi ba rwiyemezamirimo mu karere binyuze ku isoko rikora neza n’ibikoresho by’ingenzi."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuunganisha na kuwawezesha wajasiriamali kupitia soko lenye shughuli na zana muhimu za biashara."
