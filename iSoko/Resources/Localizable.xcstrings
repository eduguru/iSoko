      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecting and empowering entrepreneurs across the region by providing access to a vibrant marketplace and essential business tools."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecter et autonomiser les entrepreneurs de la région grâce à un marché dynamique et des outils essentiels."
