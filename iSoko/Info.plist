<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIAppFonts</key>
	<array>
		<string>Poppins-Regular.ttf</string>
		<string>Poppins-Medium.ttf</string>
		<string>Poppins-SemiBold.ttf</string>
		<string>Poppins-Bold.ttf</string>
	</array>
	<key>API_DOMAIN</key>
	<string>$(API_DOMAIN)</string>
	<key>API_PATH</key>
	<string>$(API_PATH)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>app</string>
			</array>
		</dict>
	</array>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:api.dev.isoko.africa</string>
	</array>
	<key>CLIENT_ID</key>
	<string>$(CLIENT_ID)</string>
	<key>CLIENT_SECRET</key>
	<string>$(CLIENT_SECRET)</string>
	<key>DEFAULT_COUNTRY_CODE</key>
	<string>$(COUNTRY_CODE)</string>
	<key>ENVIRONMENT</key>
	<string>$(ENVIRONMENT)</string>
	<key>GIDClientID</key>
	<string>994100242590-8fbiek5bhnlkedbgs7s8jdf18tmcv7mf.apps.googleusercontent.com</string>
	<key>IMAGE_DOMAIN</key>
	<string>$(IMAGE_DOMAIN)</string>
	<key>LEGACY_CORE_DOMAIN</key>
	<string>$(LEGACY_CORE_DOMAIN)</string>
	<key>LEGACY_CORE_PATH</key>
	<string>$(LEGACY_CORE_PATH)</string>

	<!-- Permissions: kept only where there's a clear, matching feature -->

	<key>NSCameraUsageDescription</key>
	<string>Isoko uses your camera so you can take photos for product reviews, or scan a barcode/QR code to quickly find a product.</string>

	<key>NSPhotoLibraryUsageDescription</key>
	<string>Isoko accesses your photo library so you can attach photos to product reviews or set a profile picture.</string>

	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Isoko saves your order receipts and confirmation images to your photo library so you can access them later.</string>

	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Isoko uses your location to show delivery availability, estimate shipping times, and find the nearest pickup point.</string>

	<key>NSFaceIDUsageDescription</key>
	<string>Isoko uses Face ID to securely sign you in and authorize payments.</string>

	<!-- Removed (no clear ecommerce use case):
	     NSMicrophoneUsageDescription
	     NSLocationAlwaysUsageDescription
	     NSLocationAlwaysAndWhenInUseUsageDescription
	     NSContactsUsageDescription
	     NSCalendarsUsageDescription
	     NSRemindersUsageDescription
	     NSMotionUsageDescription
	     NSBluetoothAlwaysUsageDescription
	     NSBluetoothPeripheralUsageDescription
	     NSAppleMusicUsageDescription
	     If any of these map to a real feature (e.g. voice search, gift-to-contact,
	     delivery-day calendar entries), add the key back with a specific string
	     rather than a generic one. -->

	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>isoko.africa</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
